#include <winver.h>

#ifndef RT_MANIFEST
#define RT_MANIFEST 24
#endif

1 ICON "vector_pdf/assets/vector-pdf.ico"
1 RT_MANIFEST "tools/launcher.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,3,2,0
 PRODUCTVERSION 0,3,2,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "VECTOR PDF"
            VALUE "FileDescription", "VECTOR PDF portable launcher"
            VALUE "FileVersion", "0.3.2.0"
            VALUE "InternalName", "VectorPDF"
            VALUE "LegalCopyright", "Copyright (c) 2026 VECTOR PDF contributors"
            VALUE "OriginalFilename", "VectorPDF.exe"
            VALUE "ProductName", "VECTOR PDF"
            VALUE "ProductVersion", "0.3.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
